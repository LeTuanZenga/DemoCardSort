istory.push(cloneState());\n        isAnimating = true;\n        col.splice(col.length - count, count);\n        for (let i = 0; i < count; i++) {\n          columns[match.targetIdx].push(color);\n        }\n        await checkAndClearColumn(match.targetIdx);\n        isAnimating = false;\n        render();\n        return;\n      }\n\n      // 2. Move 1 card to the first available Free Slot\n      const emptySlotIdx = holdingSlots.findIndex(s => s === null);\n      if (emptySlotIdx !== -1) {\n        history.push(cloneState());\n        col.pop();\n        holdingSlots[emptySlotIdx] = color;\n        render();\n        return;\n      }\n\n      // 3. No target and slots full -> shake\n      triggerShake(document.getElementById(`col-wrap-${colIdx}`));\n    }\n\n    async function onSlotClick(slotIdx) {\n      if (isAnimating) return;\n      const color = holdingSlots[slotIdx];\n      if (color === null) return;\n\n      const match = findTargetColumnForSlot(color);\n      if (!match) {\n        triggerShake(document.getElementById(`slot-${slotIdx}`));\n        return;\n      }\n\n      history.push(cloneState());\n      isAnimating = true;\n      holdingSlots[slotIdx] = null;\n      columns[match.targetIdx].push(color);\n      await checkAndClearColumn(match.targetIdx);\n      isAnimating = false;\n      render();\n    }\n\n    function undoMove() {\n      if (history.length === 0 || isAnimating) return;\n      const prev = history.pop();\n      columns = prev.columns;\n      holdingSlots = prev.holdingSlots;\n      render();\n    }\n\n    resetGame();\n  </script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\Admin\\.gemini\\antigravity\\brain\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\pixel_art_card_sort_playable.html"}}]}
