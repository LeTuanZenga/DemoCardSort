r {\n      transform: translateY(-2px) scale(1.03);\n    }\n    @keyframes shake {\n      0%, 100% { transform: translateX(0); }\n      25% { transform: translateX(-5px); }\n      75% { transform: translateX(5px); }\n    }\n    .shake-anim {\n      animation: shake 0.25s ease-in-out;\n    }\n  </style>\n</head>\n<body class=\"bg-transparent text-[var(--foreground)] antialiased p-2 select-none\">\n  <div class=\"bg-[var(--card)] text-[var(--foreground)] border border-[var(--border)] rounded-xl p-4 shadow-sm\">\n    <!-- Header & Controls -->\n    <div class=\"flex flex-wrap items-center justify-between gap-2 mb-2.5\">\n      <div>\n        <div class=\"flex items-center gap-2\">\n          <h2 class=\"text-[var(--foreground)] font-semibold text-base\">Card Sort: Cơ chế Bẫy \"0 Nước Đi\" (Game Over)</h2>\n          <span id=\"level-badge\" class=\"text-xs px-2 py-0.5 rounded-full bg-[var(--secondary)] text-[var(--secondary-foreground)] font-medium\">Màn 1</span>\n        </div>\n        <p id=\"status-text\" class=\"text-[var(--muted-foreground)] text-xs mt-0.5\">\n          3 Cột · 4 Màu: Nếu đẩy nhầm quân bài xuống Slot làm lộ 4 màu khác nhau trên 3 cột + 1 Slot ➔ Hết sạch nước đi!\n        </p>\n      </div>\n      <div class=\"flex items-center gap-1.5\">\n        <button id=\"btn-undo\" onclick=\"undoMove()\" class=\"text-xs px-2.5 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--background)] hover:opacity-80 disabled:opacity-40 font-medium\">\n          ↩ Undo\n        </button>\n        <button onclick=\"resetLevel()\" class=\"text-xs px-2.5 py-1.5 rounded-lg border border-[var(--border)] bg-[var(--background)] hover:opacity-80 font-medium\">\n          ⟳ Chơi lại\n        </button>\n        <button onclick=\"nextLevel()\" class=\"text-xs px-2.5 py-1.5 rounded-lg bg-[var(--primary)] text-[var(--primary-foreground)] hover:opacity-90 font-medium\">\n          Đổi màn (1/2)\n        </button>\n      </div>\n    </div>\n\n    <!-- Game Over / Win Banner -->\n    <div id=\"banner-box\" class=\"hidden mb-2.5 px-3 py-2 rounded-lg border text-xs font-medium flex items-center justify-between\">\n      <span id=\"banner-text\"></span>\n      <button onclick=\"undoMove()\" class=\"px-2 py-1 rounded bg-black/20 hover:bg-black/30 text-white font-semibold shrink-0 ml-2\">\n        ↩ Đi lại bước vừa rồi\n      </button>\n    </div>\n\n    <!-- Columns Area -->\n    <div id=\"columns-container\" class=\"grid grid-cols-3 gap-3 mb-3 min-h-[225px] items-start\">\n      <!-- Rendered via JS -->\n    </div>\n\n    <!-- Bottom Holding Slot Area -->\n    <div class=\"rounded-xl border border-[var(--border)] bg-[var(--background)] p-2.5 flex flex-col sm:flex-row items-center justify-between gap-3\">\n      <div class=\"text-xs text-[var(--muted-foreground)] space-y-0.5\">\n        <div class=\"font-semibold text-[var(--foreground)] flex items-center gap-2\">\n          <span>📥 Slot Trống (Tối đa 1 quân)</span>\n          <span id=\"valid-moves-badge\" class=\"px-2 py-0.5 rounded bg-[var(--secondary)] text-[var(--secondary-foreground)] text-xs\">Nước đi khả dụng: 3</span>\n        </div>\n        <div id=\"hint-text\">Thử bấm Cột 1 hoặc Cột 3 để thấy trạng thái Thua (0 nước đi), hoặc bấm Cột 2 để giải!</div>\n      </div>\n\n      <div id=\"holding-slot\" onclick=\"onSlotClick()\" class=\"w-52 h-11 rounded-xl border-2 border-dashed border-[var(--border)] flex items-center justify-center cursor-pointer transition-colors hover:border-[var(--primary)] px-2 shrink-0\">\n        <!-- Slot content rendered via JS -->\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const COLORS = {\n      R: { name: 'Đỏ', bg: '#ef4444', border: '#b91c1c', text: '#ffffff', label: 'ĐỎ' },\n      Y: { name: 'Vàng', bg: '#eab308', border: '#a16207', text: '#ffffff', label: 'VÀNG' },\n      B: { name: 'Xanh', bg: '#3b82f6', border: '#1d4ed8', text: '#ffffff', label: 'XANH' },\n      P: { name: 'Tím', bg: '#a855f7', border: '#6b21a8', text: '#ffffff', label: 'TÍM' }\n    };\n\n    const LEVELS = [\n      {\n        name: 'Màn 1 (3 Cột · 4 Màu · Bẫy 0 Nước Đi)',\n        targetCount: 3,\n        hint: 'Thử bấm Cột 1 hoặc Cột 3 ngay đầu game sẽ THUA NGAY (0 nước đi). Cách giải: C2 ➔ C2 ➔ C2 ➔ C1 ➔ C3 ➔ C1 ➔ C1 ➔ C3 ➔ Slot.',\n        columns: [\n          ['R', 'P', 'R', 'Y'],\n          ['Y', 'P', 'Y', 'B'],\n          ['B', 'B', 'R', 'P']\n        ]\n      },\n      {\n        name: 'Màn 2 (3 Cột · 4 Màu · Bẫy Giữa Game)',\n        targetCount: 3,\n        hint: 'Bấm Cột 1 hoặc Cột 2 ở Bước 1 sẽ THUA NGAY. Cách giải: C3 ➔ C3 ➔ C3 ➔ C2 ➔ C1 ➔ C2 ➔ C2 ➔ C1 ➔ Slot.',\n        columns: [\n          ['Y', 'Y', 'B', 'R'],\n          ['B', 'R', 'B', 'P'],\n          ['P', 'R', 'P', 'Y']\n        ]\n      }\n    ];\n\n    let currentLevelIdx = 0;\n    let columns = [];\n    let holdingSlot = null;\n    let history = [];\n    let isAnimating = false;\n\n    function cloneState() {\n      return {\n        columns: columns.map(c => [...c]),\n        holdingSlot\n      };\n    }\n\n    function initLevel(idx) {\n      currentLevelIdx = idx;\n      const lvl = LEVELS[idx];\n      columns = lvl.columns.map(c => [...c]);\n      holdingSlot = null;\n      history = [];\n      isAnimating = false;\n      document.getElementById('level-badge').textContent = lvl.name;\n      document.getElementById('hint-text').textContent = lvl.hint;\n      setStatus('Click vào cột để di chuyển bài. Cẩn thận: Đẩy nhầm quân xuống Slot sẽ dẫn đến 0 nước đi!');\n      render();\n    }\n\n    function setStatus(msg) {\n      document.getElementById('status-text').textContent = msg;\n    }\n\n    function getBottomGroupCount(col) {\n      if (col.length === 0) return 0;\n      const bottomColor = col[col.length - 1];\n      let count = 0;\n      for (let i = col.length - 1; i >= 0; i--) {\n        if (col[i] === bottomColor) count++;\n        else break;\n      }\n      return count;\n    }\n\n    function isPureFullColumn(col) {\n      const target = LEVELS[currentLevelIdx].targetCount;\n      if (col.length !== target) return false;\n      return getBottomGroupCount(col) === target;\n    }\n\n    function findTargetColumnForColumnClick(color, startColIdx) {\n      const n = columns.length;\n      for (let step = 1; step < n; step++) {\n        const idx = (startColIdx + step) % n;\n        const col = columns[idx];\n        if (col.length > 0 && col[col.length - 1] === color) {\n          return { targetIdx: idx, reason: 'color_match' };\n        }\n      }\n      for (let step = 1; step < n; step++) {\n        const idx = (startColIdx + step) % n;\n        if (columns[idx].length === 0) {\n          return { targetIdx: idx, reason: 'empty_col' };\n        }\n      }\n      return null;\n    }\n\n    function findTargetColumnForSlot(color) {\n      for (let idx = 0; idx < columns.length; idx++) {\n        const col = columns[idx];\n        if (col.length > 0 && col[col.length - 1] === color) {\n          return { targetIdx: idx, reason: 'color_match' };\n        }\n      }\n      for (let idx = 0; idx < columns.length; idx++) {\n        if (columns[idx].length === 0) {\n          return { targetIdx: idx, reason: 'empty_col' };\n        }\n      }\n      return null;\n    }\n\n    function countValidMoves() {\n      let valid = 0;\n      for (let cIdx = 0; cIdx < columns.length; cIdx++) {\n        const col = columns[cIdx];\n        if (col.length === 0) continue;\n        const color = col[col.length - 1];\n        if (findTargetColumnForColumnClick(color, cIdx) || !holdingSlot) {\n          valid++;\n        }\n      }\n      if (holdingSlot && findTargetColumnForSlot(holdingSlot)) {\n        valid++;\n      }\n      return valid;\n    }\n\n    function triggerShake(el) {\n      if (!el) return;\n      el.classList.remove('shake-anim');\n      void el.offsetWidth;\n      el.classList.add('shake-anim');\n    }\n\n    function render() {\n      const container = document.getElementById('columns-container');\n      container.innerHTML = '';\n      const validMoves = countValidMoves();\n      const totalRemaining = columns.reduce((acc, c) => acc + c.length, 0) + (holdingSlot ? 1 : 0);\n\n      // Update valid moves badge & Game Over banner\n      const movesBadge = document.getElementById('valid-moves-badge');\n      movesBadge.textContent = `Nước đi khả dụng: ${validMoves}`;\n\n      const bannerBox = document.getElementById('banner-box');\n      const bannerText = document.getElementById('banner-text');\n\n      if (totalRemaining === 0) {\n        bannerBox.className = 'mb-2.5 px-3 py-2 rounded-lg border border-green-600 bg-green-600 text-white text-xs font-medium flex items-center justify-between';\n        bannerText.textContent = '🎉 CHIẾN THẮNG! Bạn đã vượt qua mọi bẫy và dọn sạch bàn chơi!';\n      } else if (validMoves === 0) {\n        bannerBox.className = 'mb-2.5 px-3 py-2 rounded-lg border border-red-600 bg-red-600 text-white text-xs font-medium flex items-center justify-between';\n        bannerText.textContent = '💀 THUA CUỘC (0 NƯỚC ĐI KHẢ DỤNG)! 3 cột lộ 3 màu khác nhau và Slot giữ màu thứ 4 — toàn bộ bàn chơi đã bị khóa cứng!';\n      } else {\n        bannerBox.className = 'hidden';\n      }\n\n      columns.forEach((col, cIdx) => {\n        const groupCount = getBottomGroupCount(col);\n        const colEl = document.createElement('div');\n        colEl.id = `col-box-${cIdx}`;\n        colEl.className = 'col-clickable flex flex-col items-center p-2.5 rounded-xl border border-[var(--border)] bg-[var(--background)] cursor-pointer relative min-h-[215px] transition-colors hover:border-[var(--primary)]';\n        colEl.onclick = () => onColumnClick(cIdx);\n\n        const header = document.createElement('div');\n        header.className = 'w-full flex justify-between items-center text-xs text-[var(--muted-foreground)] mb-2 font-medium';\n        header.innerHTML = `<span>Cột ${cIdx + 1}</span><span>${col.length} lá</span>`;\n        colEl.appendChild(header);\n\n        if (col.length === 0) {\n          const emptyEl = document.createElement('div');\n          emptyEl.className = 'flex-1 w-full flex items-center justify-center border border-dashed border-[var(--border)] rounded-lg text-xs text-[var(--muted-foreground)] text-center px-2';\n          emptyEl.textContent = 'Cột trống';\n          colEl.appendChild(emptyEl);\n        } else {\n          const stackEl = document.createElement('div');\n          stackEl.className = 'w-full flex flex-col items-center pt-1';\n\n          col.forEach((colorKey, cardIdx) => {\n            const c = COLORS[colorKey];\n            const isBottomGroup = cardIdx >= col.length - groupCount;\n            const card = document.createElement('div');\n            card.className = `card-item w-full h-9 rounded-lg border-2 flex items-center justify-between px-2.5 font-bold text-xs shadow-sm ${isBottomGroup ? 'bottom-group' : 'opacity-90'}`;\n            card.style.backgroundColor = c.bg;\n            card.style.borderColor = c.border;\n            card.style.color = c.text;\n            if (cardIdx > 0) {\n              card.style.marginTop = '-9px';\n            }\n\n            let badgeText = '';\n            if (cardIdx === col.length - 1) {\n              const match = findTargetColumnForColumnClick(colorKey, cIdx);\n              if (match) {\n                badgeText = `Ghép ${groupCount} lá ➔ Cột ${match.targetIdx + 1}`;\n              } else if (!holdingSlot) {\n                badgeText = `Đẩy 1 lá ➔ Slot ▼`;\n              } else {\n                badgeText = `🔒 Vô hiệu`;\n              }\n            }\n\n            card.innerHTML = `\n              <span>${c.label}</span>\n              ${badgeText ? `<span class=\"px-1.5 py-0.5 rounded bg-black/25 text-xs\">${badgeText}</span>` : ''}\n            `;\n            stackEl.appendChild(card);\n          });\n          colEl.appendChild(stackEl);\n        }\n\n        container.appendChild(colEl);\n      });\n\n      // Render holding slot\n      const slotEl = document.getElementById('holding-slot');\n      slotEl.innerHTML = '';\n      if (!holdingSlot) {\n        slotEl.className = 'w-56 h-11 rounded-xl border-2 border-dashed border-[var(--border)] flex items-center justify-center text-xs text-[var(--muted-foreground)] shrink-0';\n        slotEl.textContent = 'Trống (Chứa tối đa 1 quân)';\n      } else {\n        const c = COLORS[holdingSlot];\n        const target = findTargetColumnForSlot(holdingSlot);\n        slotEl.className = 'w-56 h-11 rounded-xl border-2 border-[var(--border)] p-1 flex items-center justify-center cursor-pointer shrink-0';\n        const card = document.createElement('div');\n        card.className = 'slot-card w-full h-full rounded-lg border-2 flex items-center justify-between px-3 font-bold text-xs shadow-sm transition-transform';\n        card.style.backgroundColor = c.bg;\n        card.style.borderColor = c.border;\n        card.style.color = c.text;\n        card.innerHTML = `\n          <span>${c.label} (1 lá)</span>\n          <span class=\"px-1.5 py-0.5 rounded bg-black/25 text-xs\">${target ? `➔ Cột ${target.targetIdx + 1} ▲` : '🔒 Vô hiệu'}</span>\n        `;\n        slotEl.appendChild(card);\n      }\n\n      document.getElementById('btn-undo').disabled = history.length === 0 || isAnimating;\n    }\n\n    async function sleep(ms) {\n      return new Promise(r => setTimeout(r, ms));\n    }\n\n    async function checkAndClearPureColumn(colIdx) {\n      const col = columns[colIdx];\n      const target = LEVELS[currentLevelIdx].targetCount;\n      if (isPureFullColumn(col)) {\n        const colorKey = col[0];\n        render();\n        await sleep(250);\n        col.splice(0, col.length);\n        setStatus(`💥 Cột ${colIdx + 1} gom đủ ${target} lá ${COLORS[colorKey].name} thuần 1 màu ➔ CLEAR SẠCH CỘT!`);\n        render();\n      }\n    }\n\n    async function onColumnClick(colIdx) {\n      if (isAnimating) return;\n      const col = columns[colIdx];\n      if (col.length === 0) return;\n\n      const count = getBottomGroupCount(col);\n      const color = col[col.length - 1];\n      const match = findTargetColumnForColumnClick(color, colIdx);\n\n      if (match) {\n        history.push(cloneState());\n        isAnimating = true;\n        col.splice(col.length - count, count);\n        for (let i = 0; i < count; i++) {\n          columns[match.targetIdx].push(color);\n        }\n        setStatus(`✅ Đẩy ${count} lá ${COLORS[color].name} từ Cột ${colIdx + 1} sang Cột ${match.targetIdx + 1}.`);\n        await checkAndClearPureColumn(match.targetIdx);\n        isAnimating = false;\n        render();\n        return;\n      }\n\n      if (!holdingSlot) {\n        history.push(cloneState());\n        col.pop();\n        holdingSlot = color;\n        setStatus(`📥 Đẩy 1 lá ${COLORS[color].name} từ Cột ${colIdx + 1} xuống Slot trống.`);\n        render();\n        return;\n      }\n\n      triggerShake(document.getElementById(`col-box-${colIdx}`));\n      setStatus(`⚠️ Vô hiệu! Cột ${colIdx + 1} không có cột trùng màu/trống và Slot dưới đã đầy.`);\n    }\n\n    async function onSlotClick() {\n      if (isAnimating || !holdingSlot) return;\n\n      const color = holdingSlot;\n      const match = findTargetColumnForSlot(color);\n      if (!match) {\n        triggerShake(document.getElementById('holding-slot'));\n        setStatus(`⚠️ Vô hiệu! Không có cột nào trùng màu ${COLORS[color].name} và chưa có cột trống.`);\n        return;\n      }\n\n      history.push(cloneState());\n      isAnimating = true;\n      holdingSlot = null;\n      columns[match.targetIdx].push(color);\n      setStatus(`🔼 Đẩy lá ${COLORS[color].name} từ Slot tạm lên Cột ${match.targetIdx + 1}.`);\n      await checkAndClearPureColumn(match.targetIdx);\n      isAnimating = false;\n      render();\n    }\n\n    function undoMove() {\n      if (history.length === 0 || isAnimating) return;\n      const prev = history.pop();\n      columns = prev.columns;\n      holdingSlot = prev.holdingSlot;\n      setStatus('Đã quay lại 1 bước (Undo).');\n      render();\n    }\n\n    function resetLevel() {\n      if (isAnimating) return;\n      initLevel(currentLevelIdx);\n    }\n\n    function nextLevel() {\n      if (isAnimating) return;\n      initLevel((currentLevelIdx + 1) % LEVELS.length);\n    }\n\n    initLevel(0);\n  </script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\Admin\\.gemini\\antigravity\\brain\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\conveyor_card_sort_demo.html"}}]}
