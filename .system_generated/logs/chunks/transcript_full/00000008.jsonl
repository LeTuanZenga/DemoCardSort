ument.getElementById(`col-stack-${colIdx}`);\n              const srcRect = getRelativeRect(srcStackEl);\n              const srcStepY = getStepY(col.length);\n              const startX = srcRect.left;\n              const startY = srcRect.top + (col.length - 1) * srcStepY;\n\n              col.pop();\n              render();\n\n              const dstCol = columns[fallbackColIdx];\n              const dstStackEl = document.getElementById(`col-stack-${fallbackColIdx}`);\n              const dstRect = getRelativeRect(dstStackEl);\n              const dstStepY = getStepY(dstCol.length + 1);\n              const endX = dstRect.left;\n              const endY = dstRect.top + dstCol.length * dstStepY;\n\n              launchFlyingCard({\n                color,\n                startX,\n                startY,\n                startW: CARD_W,\n                startH: CARD_H,\n                endX,\n                endY,\n                endW: CARD_W,\n                endH: CARD_H,\n                durationMs: FLIGHT_MS,\n                onLand: () => {\n                  columns[fallbackColIdx].push(color);\n                  landedCount += 1;\n                  render();\n                  if (landedCount === count) {\n                    resolveAll();\n                  }\n                }\n              });\n            }, i * STAGGER_MS);\n          }\n        });\n\n        isAnimating = false;\n        render();\n        return;\n      }\n\n      // Invalid move\n      triggerShake(document.getElementById(`col-wrap-${colIdx}`));\n    }\n\n    function undoMove() {\n      if (history.length === 0 || isAnimating) return;\n      const prev = history.pop();\n      columns = prev.columns;\n      slots = prev.slots;\n      render();\n    }\n\n    function resetGame() {\n      if (isAnimating) return;\n      columns = buildInitialColumns();\n      slots = [null, null, null, null];\n      history = [];\n      isAnimating = false;\n      render();\n    }\n\n    resetGame()