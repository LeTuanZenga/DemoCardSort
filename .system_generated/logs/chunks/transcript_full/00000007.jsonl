r);\n  if (sIdx === -1) sIdx = slots.findIndex(s => s === null);\n\n  if (sIdx !== -1) {\n    const target = getTarget(cols, slots, color);\n    const cur = slots[sIdx] ? slots[sIdx].count : 0;\n    const need = target - cur;\n    const take = Math.min(count, need);\n    col.splice(col.length - take, take);\n    if (!slots[sIdx]) slots[sIdx] = { color, count: take };\n    else slots[sIdx].count += take;\n    if (slots[sIdx].count >= target) {\n      slots[sIdx] = null;\n    }\n    return { cols, slots };\n  }\n\n  const n = cols.length;\n  for (let s = 1; s < n; s++) {\n    const idx = (colIdx + s) % n;\n    if (cols[idx].length > 0 && cols[idx][cols[idx].length - 1] === color) {\n      col.splice(col.length - count, count);\n      for (let i = 0; i < count; i++) cols[idx].push(color);\n      return { cols, slots };\n    }\n  }\n  return null;\n}\n\nconst visited = new Set();\nlet winPath = null;\nfunction dfs(state, path) {\n  if (winPath) return;\n  const rem = state.cols.reduce((a, c) => a + c.length, 0) + state.slots.reduce((a, s) => a + (s ? s.count : 0), 0);\n  if (rem === 0) { winPath = path; return; }\n  const key = JSON.stringify(state);\n  if (visited.has(key)) return;\n  visited.add(key);\n  // Prioritize moves that match an ALREADY occupied slot first!\n  const order = [0,1,2,3,4,5].sort((a, b) => {\n    const ca = state.cols[a].length ? state.cols[a][state.cols[a].length - 1] : null;\n    const cb = state.cols[b].length ? state.cols[b][state.cols[b].length - 1] : null;\n    const ma = state.slots.some(s => s && s.color === ca) ? 0 : 1;\n    const mb = state.slots.some(s => s && s.color === cb) ? 0 : 1;\n    return ma - mb;\n  });\n  for (const i of order) {\n    const next = stepCol(state, i);\n    if (next) dfs(next, [...path, 'C' + (i + 1)]);\n  }\n}\ndfs({ cols: buildCols(GRID_6X16), slots: [null, null, null, null] }, []);\nconsole.log('Winnable?', winPath ? 'YES in ' + winPath.length + ' moves!' : 'NO');\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Verify winnability of 6x16 Mushroom with 4 Deck Slots"}}]}
