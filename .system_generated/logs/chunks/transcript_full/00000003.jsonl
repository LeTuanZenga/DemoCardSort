-scalable=no\\\">\n  <title>3D Solitaire Color Sort</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n    body {\n      background: #06180e;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n      overflow: hidden;\n      padding: 10px;\n    }\n    #game-container {\n      position: relative;\n      width: 360px;\n      height: 600px;\n      border-radius: 28px;\n      overflow: hidden;\n      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 0 4px #082815;\n      background: #0c331a;\n      transition: box-shadow 0.3s ease, border-color 0.3s ease;\n    }\n    #three-canvas {\n      width: 100%;\n      height: 100%;\n      display: block;\n      outline: none;\n      cursor: pointer;\n    }\n    /* Top Bar UI */\n    #ui-overlay {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      padding: 16px 18px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      pointer-events: none;\n      z-index: 10;\n    }\n    .btn-group {\n      display: flex;\n      gap: 8px;\n      pointer-events: auto;\n    }\n    .icon-btn {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      background: rgba(0, 0, 0, 0.45);\n      border: 1px solid rgba(255, 255, 255, 0.22);\n      color: #ffffff;\n      font-size: 15px;\n      font-weight: bold;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      backdrop-filter: blur(4px);\n      transition: transform 0.1s, background 0.2s, opacity 0.2s;\n    }\n    .icon-btn:active {\n      transform: scale(0.92);\n    }\n    .icon-btn:disabled {\n      opacity: 0.3;\n      cursor: default;\n    }\n    .next-btn {\n      background: #eab308;\n      border-color: #fef08a;\n      color: #000;\n      font-size: 13px;\n    }\n    .next-btn:active {\n      transform: scale(0.92);\n    }\n    #level-dots {\n      display: flex;\n      gap: 6px;\n      align-items: center;\n    }\n    .dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.25);\n      transition: all 0.3s ease;\n    }\n    .dot.active {\n      background: #facc15;\n      transform: scale(1.3);\n      box-shadow: 0 0 8px rgba(250, 204, 21, 0.6);\n    }\n    /* Win / Deadlock glow states */\n    #game-container.win-state {\n      box-shadow: 0 0 40px rgba(34, 197, 94, 0.8), 0 0 0 4px #22c55e;\n    }\n    #game-container.dead-state {\n      box-shadow: 0 0 40px rgba(239, 68, 68, 0.85), 0 0 0 4px #ef4444;\n    }\n  </style>\n</head>\n<body>\n\n  <div id=\\\"game-container\\\">\n    <!-- WebGL Canvas for 3D Cards & Felt Table -->\n    <canvas id=\\\"three-canvas\\\"></canvas>\n\n    <!-- Minimalist Floating Controls -->\n    <div id=\\\"ui-overlay\\\">\n      <div class=\\\"btn-group\\\">\n        <button id=\\\"btn-undo\\\" class=\\\"icon-btn\\\" onclick=\\\"undoMove()\\\" title=\\\"Undo\\\">↩</button>\n        <button class=\\\"icon-btn\\\" onclick=\\\"resetLevel()\\\" title=\\\"Chơi lại\\\">⟳</button>\n      </div>\n\n      <div id=\\\"level-dots\\\">\n        <div class=\\\"dot active\\\"></div>\n        <div class=\\\"dot\\\"></div>\n        <div class=\\\"dot\\\"></div>\n      </div>\n\n      <div class=\\\"btn-group\\\">\n        <button class=\\\"icon-btn next-btn\\\" onclick=\\\"nextLevel()\\\" title=\\\"Màn tiếp theo\\\">➔</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Inlined Three.js Library -->\n  <script>\n` + threeJsCode + `\n  </script>\n\n  <!-- 3D Card Sort Core Logic & Scene Controller -->\n  <script>\n    // Color definitions with physical materials\n    const COLOR_DEFS = {\n      R: { hex: 0xef4444, rim: 0xffffff, name: 'Đỏ' },\n      Y: { hex: 0xf59e0b, rim: 0xffffff, name: 'Vàng' },\n      B: { hex: 0x3b82f6, rim: 0xffffff, name: 'Xanh' },\n      P: { hex: 0xa855f7, rim: 0xffffff, name: 'Tím' }\n    };\n\n    const LEVELS = [\n      // Level 1: Dễ (2 màu, 6 lá, làm quen)\n      {\n        targetCount: 3,\n        columns: [\n          ['B', 'R'],\n          ['R', 'B'],\n          ['R', 'B']\n        ]\n      },\n      // Level 2: Vừa (3 màu, 9 lá)\n      {\n        targetCount: 3,\n        columns: [\n          ['R', 'B', 'Y'],\n          ['B', 'R', 'B'],\n          ['Y', 'Y', 'R']\n        ]\n      },\n      // Level 3: Khó (4 màu, 12 lá sâu 4 lớp, bẫy 0 nước đi)\n      {\n        targetCount: 3,\n        columns: [\n          ['Y', 'P', 'Y', 'B'],\n          ['B', 'B', 'R', 'P'],\n          ['P', 'R', 'Y', 'R']\n        ]\n      }\n    ];\n\n    let currentLevelIdx = 0;\n    let columns = [];\n    let holdingSlot = null; // null or color key\n    let history = [];\n    let isAnimating = false;\n\n    // --- THREE.JS 3D ENGINE SETUP ---\n    const container = document.getElementById('game-container');\n    const canvas = document.getElementById('three-canvas');\n    const width = 360;\n    const height = 600;\n\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x0e3a1f);\n\n    const camera = new THREE.PerspectiveCamera(46, width / height, 0.1, 100);\n    camera.position.set(0, 14.2, 10.8);\n    camera.lookAt(0, 0, 0.5);\n\n    const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n\n    // Lighting\n    const ambientLight = new THREE.AmbientLight(0xffffff, 0.72);\n    scene.add(ambientLight);\n\n    const dirLight = new THREE.DirectionalLight(0xffffff, 0.78);\n    dirLight.position.set(4, 18, 9);\n    dirLight.castShadow = true;\n    dirLight.shadow.mapSize.width = 1024;\n    dirLight.shadow.mapSize.height = 1024;\n    dirLight.shadow.camera.near = 0.5;\n    dirLight.shadow.camera.far = 40;\n    dirLight.shadow.camera.left = -6;\n    dirLight.shadow.camera.right = 6;\n    dirLight.shadow.camera.top = 8;\n    dirLight.shadow.camera.bottom = -8;\n    dirLight.shadow.bias = -0.001;\n    scene.add(dirLight);\n\n    // Green Felt Table Mesh\n    const feltGeo = new THREE.PlaneGeometry(16, 24);\n    const feltMat = new THREE.MeshStandardMaterial({\n      color: 0x13532c,\n      roughness: 0.88,\n      metalness: 0.05\n    });\n    const feltTable = new THREE.Mesh(feltGeo, feltMat);\n    feltTable.rotation.x = -Math.PI / 2;\n    feltTable.position.y = -0.05;\n    feltTable.receiveShadow = true;\n    scene.add(feltTable);\n\n    // Layout Coordinates\n    const COL_X = [-2.25, 0, 2.25];\n    const COL_START_Z = -3.2;\n    const Z_STEP = 0.95;\n    const Y_THICKNESS = 0.05;\n    const CARD_W = 1.75;\n    const CARD_H = 2.45;\n    const SLOT_POS = new THREE.Vector3(0, 0.02, 2.55);\n\n    // Create Base Placeholders (Column and Slot outlines)\n    const lineMat = new THREE.LineDashedMaterial({\n      color: 0xffffff,\n      dashSize: 0.25,\n      gapSize: 0.15,\n      opacity: 0.28,\n      transparent: true\n    });\n\n    function createCardOutline(x, z) {\n      const hw = CARD_W / 2;\n      const hh = CARD_H / 2;\n      const pts = [\n        new THREE.Vector3(-hw, 0.01, -hh),\n        new THREE.Vector3(hw, 0.01, -hh),\n        new THREE.Vector3(hw, 0.01, hh),\n        new THREE.Vector3(-hw, 0.01, hh),\n        new THREE.Vector3(-hw, 0.01, -hh)\n      ];\n      const geo = new THREE.BufferGeometry().setFromPoints(pts);\n      const line = new THREE.Line(geo, lineMat);\n      line.computeLineDistances();\n      line.position.set(x, 0, z);\n      scene.add(line);\n      return line;\n    }\n\n    COL_X.forEach(x => createCardOutline(x, COL_START_Z));\n    createCardOutline(SLOT_POS.x, SLOT_POS.z);\n\n    // Interactive Hit Planes (for raycasting columns & slot)\n    const interactivePlanes = [];\n\n    COL_X.forEach((x, idx) => {\n      const planeGeo = new THREE.PlaneGeometry(2.1, 7.5);\n      const planeMat = new THREE.MeshBasicMaterial({ visible: false });\n      const plane = new THREE.Mesh(planeGeo, planeMat);\n      plane.rotation.x = -Math.PI / 2;\n      plane.position.set(x, 0.01, -0.6);\n      plane.userData = { type: 'col', colIdx: idx };\n      scene.add(plane);\n      interactivePlanes.push(plane);\n    });\n\n    const slotHitGeo = new THREE.PlaneGeometry(2.1, 2.8);\n    const slotHitMat = new THREE.MeshBasicMaterial({ visible: false });\n    const slotHit = new THREE.Mesh(slotHitGeo, slotHitMat);\n    slotHit.rotation.x = -Math.PI / 2;\n    slotHit.position.set(SLOT_POS.x, 0.01, SLOT_POS.z);\n    slotHit.userData = { type: 'slot' };\n    scene.add(slotHit);\n    interactivePlanes.push(slotHit);\n\n    // 3D Card Mesh Factory\n    // White card base with colored top face and subtle bevel\n    const cardBaseGeo = new THREE.BoxGeometry(CARD_W, Y_THICKNESS, CARD_H);\n    const cardFaceGeo = new THREE.PlaneGeometry(CARD_W - 0.12, CARD_H - 0.12);\n\n    const materials = {};\n    Object.keys(COLOR_DEFS).forEach(k => {\n      materials[k] = new THREE.MeshStandardMaterial({\n        color: COLOR_DEFS[k].hex,\n        roughness: 0.32,\n        metalness: 0.08\n      });\n    });\n\n    const whiteCardBaseMat = new THREE.MeshStandardMaterial({\n      color: 0xfcfcfc,\n      roughness: 0.45,\n      metalness: 0.05\n    });\n\n    function create3DCard(colorKey) {\n      const group = new THREE.Group();\n      \n      const base = new THREE.Mesh(cardBaseGeo, whiteCardBaseMat);\n      base.castShadow = true;\n      base.receiveShadow = true;\n      group.add(base);\n\n      const face = new THREE.Mesh(cardFaceGeo, materials[colorKey]);\n      face.rotation.x = -Math.PI / 2;\n      face.position.y = Y_THICKNESS / 2 + 0.002;\n      face.receiveShadow = false;\n      group.add(face);\n\n      group.userData = { colorKey };\n      return group;\n    }\n\n    // Active Card 3D Instances\n    // cardMeshesByColumn: Array of arrays [colIdx][cardIdx] -> 3D Group\n    let cardMeshesByColumn = [[], [], []];\n    let slotCardMesh = null;\n\n    // Active Animations\n    const activeTweens = [];\n\n    function addTween(duration, onUpdate, onComplete) {\n      activeTweens.push({\n        elapsed: 0,\n        duration: duration,\n        onUpdate: onUpdate,\n        onComplete: onComplete\n      });\n    }\n\n    // --- GAMEPLAY MECHANICS ---\n    function cloneState() {\n      return {\n        columns: columns.map(c => [...c]),\n        holdingSlot\n      };\n    }\n\n    function getBottomGroupCount(col) {\n      if (col.length === 0) return 0;\n      const bottomColor = col[col.length - 1];\n      let count = 0;\n      for (let i = col.length - 1; i >= 0; i--) {\n        if (col[i] === bottomColor) count++;\n        else break;\n      }\n      return count;\n    }\n\n    function isPureFullColumn(col) {\n      const target = LEVELS[currentLevelIdx].targetCount;\n      if (col.length !== target) return false;\n      return getBottomGroupCount(col) === target;\n    }\n\n    function findTargetColumnForColumnClick(color, startColIdx) {\n      const n = columns.length;\n      for (let step = 1; step < n; step++) {\n        const idx = (startColIdx + step) % n;\n        const col = columns[idx];\n        if (col.length > 0 && col[col.length - 1] === color) {\n          return { targetIdx: idx };\n        }\n      }\n      for (let step = 1; step < n; step++) {\n        const idx = (startColIdx + step) % n;\n        if (columns[idx].length === 0) {\n          return { targetIdx: idx };\n        }\n      }\n      return null;\n    }\n\n    function findTargetColumnForSlot(color) {\n      for (let idx = 0; idx < columns.length; idx++) {\n        const col = columns[idx];\n        if (col.length > 0 && col[col.length - 1] === color) {\n          return { targetIdx: idx };\n        }\n      }\n      for (let idx = 0; idx < columns.length; idx++) {\n        if (columns[idx].length === 0) {\n          return { targetIdx: idx };\n        }\n      }\n      return null;\n    }\n\n    function countValidMoves() {\n      let valid = 0;\n      for (let cIdx = 0; cIdx < columns.length; cIdx++) {\n        const col = columns[cIdx];\n        if (col.length === 0) continue;\n        const color = col[col.length - 1];\n        if (findTargetColumnForColumnClick(color, cIdx) || !holdingSlot) {\n          valid++;\n        }\n      }\n      if (holdingSlot && findTargetColumnForSlot(holdingSlot)) {\n        valid++;\n      }\n      return valid;\n    }\n\n    function getCardTargetPosition(colIdx, cardIdx) {\n      return new THREE.Vector3(\n        COL_X[colIdx],\n        (cardIdx + 1) * Y_THICKNESS,\n        COL_START_Z + cardIdx * Z_STEP\n      );\n    }\n\n    function rebuild3DScene() {\n      // Clear existing card meshes\n      cardMeshesByColumn.forEach(colMeshes => {\n        colMeshes.forEach(m => scene.remove(m));\n      });\n      cardMeshesByColumn = [[], [], []];\n\n      if (slotCardMesh) {\n        scene.remove(slotCardMesh);\n        slotCardMesh = null;\n      }\n\n      // Build Column Meshes\n      columns.forEach((col, cIdx) => {\n        col.forEach((colorKey, cardIdx) => {\n          const mesh = create3DCard(colorKey);\n          const pos = getCardTargetPosition(cIdx, cardIdx);\n          mesh.position.copy(pos);\n          scene.add(mesh);\n          cardMeshesByColumn[cIdx].push(mesh);\n        });\n      });\n\n      // Build Slot Mesh\n      if (holdingSlot) {\n        slotCardMesh = create3DCard(holdingSlot);\n        slotCardMesh.position.copy(SLOT_POS);\n        scene.add(slotCardMesh);\n      }\n\n      updateUI();\n    }\n\n    function updateUI() {\n      const valid = countValidMoves();\n      const remaining = columns.reduce((acc, c) => acc + c.length, 0) + (holdingSlot ? 1 : 0);\n\n      container.classList.remove('win-state', 'dead-state');\n      if (remaining === 0) {\n        container.classList.add('win-state');\n      } else if (valid === 0) {\n        container.classList.add('dead-state');\n      }\n\n      document.getElementById('btn-undo').disabled = (history.length === 0 || isAnimating);\n\n      // Level dots\n      const dots = document.querySelectorAll('.dot');\n      dots.forEach((d, i) => {\n        if (i === currentLevelIdx) d.classList.add('active');\n        else d.classList.remove('active');\n      });\n    }\n\n    function initLevel(idx) {\n      currentLevelIdx = idx;\n      const lvl = LEVELS[idx];\n      columns = lvl.columns.map(c => [...c]);\n      holdingSlot = null;\n      history = [];\n      isAnimating = false;\n      activeTweens.length = 0;\n      rebuild3DScene();\n    }\n\n    // 3D Parabolic Flight Animation\n    function animateArc(mesh, startPos, endPos, duration, peakHeight = 2.4, onComplete) {\n      addTween(duration, (p) => {\n        // Linear X and Z\n        mesh.position.x = THREE.MathUtils.lerp(startPos.x, endPos.x, p);\n        mesh.position.z = THREE.MathUtils.lerp(startPos.z, endPos.z, p);\n        // Parabolic Y\n        const base = THREE.MathUtils.lerp(startPos.y, endPos.y, p);\n        const arc = 4 * peakHeight * p * (1 - p);\n        mesh.position.y = base + arc;\n        // Subtle tilt\n        mesh.rotation.x = Math.sin(p * Math.PI) * 0.18;\n      }, () => {\n        mesh.position.copy(endPos);\n        mesh.rotation.set(0, 0, 0);\n        if (onComplete) onComplete();\n      });\n    }\n\n    // 3D Clear Explosion Animation\n    function animateClearColumn(colIdx, onComplete) {\n      const meshes = cardMeshesByColumn[colIdx];\n      cardMeshesByColumn[colIdx] = [];\n\n      meshes.forEach((m, i) => {\n        const startY = m.position.y;\n        addTween(0.35, (p) => {\n          m.position.y = startY + p * 2.2;\n          m.rotation.y = p * Math.PI;\n          const s = Math.max(0.001, 1 - p * 1.1);\n          m.scale.set(s, s, s);\n        }, () => {\n          scene.remove(m);\n        });\n      });\n\n      setTimeout(() => {\n        if (onComplete) onComplete();\n      }, 350);\n    }\n\n    // 3D Column Shake Feedback\n    function shakeColumn3D(colIdx) {\n      const meshes = cardMeshesByColumn[colIdx];\n      if (!meshes || meshes.length === 0) return;\n      const origX = COL_X[colIdx];\n      addTween(0.25, (p) => {\n        const offset = Math.sin(p * Math.PI * 4) * 0.18 * (1 - p);\n        meshes.forEach(m => m.position.x = origX + offset);\n      }, () => {\n        meshes.forEach(m => m.position.x = origX);\n      });\n    }\n\n    function shakeSlot3D() {\n      if (!slotCardMesh) return;\n      const origX = SLOT_POS.x;\n      addTween(0.25, (p) => {\n        const offset = Math.sin(p * Math.PI * 4) * 0.18 * (1 - p);\n        slotCardMesh.position.x = origX + offset;\n      }, () => {\n        slotCardMesh.position.x = origX;\n      });\n    }\n\n    async function handleColumnClick(colIdx) {\n      if (isAnimating) return;\n      const col = columns[colIdx];\n      if (col.length === 0) return;\n\n      const count = getBottomGroupCount(col);\n      const color = col[col.length - 1];\n      const match = findTargetColumnForColumnClick(color, colIdx);\n\n      // 1. Move group to matching column or empty column\n      if (match) {\n        history.push(cloneState());\n        isAnimating = true;\n\n        const targetIdx = match.targetIdx;\n        const targetCol = columns[targetIdx];\n        const initialTargetLen = targetCol.length;\n\n        // Splice logical cards\n        col.splice(col.length - count, count);\n        for (let i = 0; i < count; i++) {\n          targetCol.push(color);\n        }\n\n        // Splice 3D meshes\n        const movingMeshes = cardMeshesByColumn[colIdx].splice(cardMeshesByColumn[colIdx].length - count, count);\n\n        // Animate each moving card with staggered arc\n        let finished = 0;\n        movingMeshes.forEach((mesh, idx) => {\n          const start = mesh.position.clone();\n          const targetCardIdx = initialTargetLen + idx;\n          const end = getCardTargetPosition(targetIdx, targetCardIdx);\n          cardMeshesByColumn[targetIdx].push(mesh);\n\n          setTimeout(() => {\n            animateArc(mesh, start, end, 0.28, 2.2, () => {\n              finished++;\n              if (finished === count) {\n                // Check if full pure column clears\n                if (isPureFullColumn(targetCol)) {\n                  targetCol.splice(0, targetCol.length);\n                  animateClearColumn(targetIdx, () => {\n                    isAnimating = false;\n                    updateUI();\n                  });\n                } else {\n                  isAnimating = false;\n                  updateUI();\n                }\n              }\n            });\n          }, idx * 60);\n        });\n        return;\n      }\n\n      // 2. Move 1 card to holding slot\n      if (!holdingSlot) {\n        history.push(cloneState());\n        isAnimating = true;\n\n        col.pop();\n        holdingSlot = color;\n\n        const movingMesh = cardMeshesByColumn[colIdx].pop();\n        slotCardMesh = movingMesh;\n\n        const start = movingMesh.position.clone();\n        animateArc(movingMesh, start, SLOT_POS, 0.3, 2.0, () => {\n          isAnimating = false;\n          updateUI();\n        });\n        return;\n      }\n\n      // Invalid move\n      shakeColumn3D(colIdx);\n    }\n\n    async function handleSlotClick() {\n      if (isAnimating || !holdingSlot) return;\n\n      const color = holdingSlot;\n      const match = findTargetColumnForSlot(color);\n      if (!match) {\n        shakeSlot3D();\n        return;\n      }\n\n      history.push(cloneState());\n      isAnimating = true;\n\n      const targetIdx = match.targetIdx;\n      const targetCol = columns[targetIdx];\n      const targetCardIdx = targetCol.length;\n\n      targetCol.push(color);\n      holdingSlot = null;\n\n      const movingMesh = slotCardMesh;\n      slotCardMesh = null;\n      cardMeshesByColumn[targetIdx].push(movingMesh);\n\n      const start = movingMesh.position.clone();\n      const end = getCardTargetPosition(targetIdx, targetCardIdx);\n\n      animateArc(movingMesh, start, end, 0.3, 2.2, () => {\n        if (isPureFullColumn(targetCol)) {\n          targetCol.splice(0, targetCol.length);\n          animateClearColumn(targetIdx, () => {\n            isAnimating = false;\n            updateUI();\n          });\n        } else {\n          isAnimating = false;\n          updateUI();\n        }\n      });\n    }\n\n    function undoMove() {\n      if (history.length === 0 || isAnimating) return;\n      const prev = history.pop();\n      columns = prev.columns;\n      holdingSlot = prev.holdingSlot;\n      rebuild3DScene();\n    }\n\n    function resetLevel() {\n      if (isAnimating) return;\n      initLevel(currentLevelIdx);\n    }\n\n    function nextLevel() {\n      if (isAnimating) return;\n      initLevel((currentLevelIdx + 1) % LEVELS.length);\n    }\n\n    // --- RAYCASTING MOUSE / TOUCH EVENTS ---\n    const raycaster = new THREE.Raycaster();\n    const mouse = new THREE.Vector2();\n\n    function onPointerDown(event) {\n      if (isAnimating) return;\n      const rect = canvas.getBoundingClientRect();\n      const clientX = event.clientX || (event.touches && event.touches[0].clientX);\n      const clientY = event.clientY || (event.touches && event.touches[0].clientY);\n      if (clientX === undefined || clientY === undefined) return;\n\n      mouse.x = ((clientX - rect.left) / rect.width) * 2 - 1;\n      mouse.y = -((clientY - rect.top) / rect.height) * 2 + 1;\n\n      raycaster.setFromCamera(mouse, camera);\n      const intersects = raycaster.intersectObjects(interactivePlanes);\n\n      if (intersects.length > 0) {\n        const hit = intersects[0].object.userData;\n        if (hit.type === 'col') {\n          handleColumnClick(hit.colIdx);\n        } else if (hit.type === 'slot') {\n          handleSlotClick();\n        }\n      }\n    }\n\n    canvas.addEventListener('pointerdown', onPointerDown);\n\n    // --- MAIN RENDER LOOP ---\n    let lastTime = performance.now();\n\n    function animate(now) {\n      requestAnimationFrame(animate);\n\n      const delta = (now - lastTime) / 1000;\n      lastTime = now;\n\n      // Process tweens\n      for (let i = activeTweens.length - 1; i >= 0; i--) {\n        const tw = activeTweens[i];\n        tw.elapsed += delta;\n        const progress = Math.min(1, tw.elapsed / tw.duration);\n        tw.onUpdate(progress);\n        if (progress >= 1) {\n          if (tw.onComplete) tw.onComplete();\n          activeTweens.splice(i, 1);\n        }\n      }\n\n      renderer.render(scene, camera);\n    }\n\n    // Start Game\n    initLevel(0);\n    requestAnimationFrame(animate);\n  </script>\n</body>\n</html>\n`;\n\nfs.writeFileSync('C:\\\\Users\\\\Admin\\\\.gemini\\\\antigravity\\\\brain\\\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\\\conveyor_card_sort_demo.html', htmlTemplate, 'utf8');\nconsole.log('Successfully wrote unified 3D single-file HTML!');\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Bundle full Three.js engine and 3D Card Sort game into a single HTML file"}}]}
