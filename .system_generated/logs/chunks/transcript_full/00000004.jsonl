_center_x = WIDTH // 2\n\n# Label for Holding Slots\ndraw.text((slot_center_x - 170, SLOT_AREA_Y - 22), \"📥 FREE SLOTS (Nhận 1 quân đáy khi không có cột cùng màu)\", fill='#bbf7d0', font=font_badge)\n\n# Slot 1: Empty placeholder\nslot1_x = slot_center_x - CARD_W - 12\ndraw.rounded_rectangle([slot1_x, SLOT_AREA_Y, slot1_x + CARD_W, SLOT_AREA_Y + CARD_H], radius=8, fill='#0c381f', outline='#ffffff44', width=2)\ndraw.text((slot1_x + 20, SLOT_AREA_Y + 44), \"TRỐNG\", fill='#ffffff55', font=font_badge)\n\n# Slot 2: Holding 1 Blue card\nslot2_x = slot_center_x + 12\ndraw.rounded_rectangle([slot2_x, SLOT_AREA_Y, slot2_x + CARD_W, SLOT_AREA_Y + CARD_H], radius=8, fill='#0c381f', outline='#ffffff44', width=2)\ndraw_card(slot2_x, SLOT_AREA_Y, 'B', is_bottom=True)\n\n# Bottom instruction bar\ndraw.text((36, HEIGHT - 38), \"• Chạm cột: Tự động gom các quân cùng màu ở đáy sang Cột trùng màu hoặc Cột trống.\", fill='#86efac', font=font_sm)\n\noutput_path = r'C:\\Users\\Admin\\.gemini\\antigravity\\brain\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\pixel_art_card_sort_8x8.png'\nimg.save(output_path, quality=95)\nprint(f\"SUCCESS: Generated high-definition pixel art image at {output_path}\")\nprint(f\"Size: {os.path.getsize(output_path)} bytes\")\n","Overwrite":true,"Path":"C:\\Users\\Admin\\.gemini\\antigravity\\brain\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\create_pixel_art_demo.py"}}]}
