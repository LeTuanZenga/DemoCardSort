RGB', (W, H), '#06170d')\\n    d = ImageDraw.Draw(img)\\n\\n    # Mobile Frame\\n    d.rounded_rectangle([10, 10, W - 10, H - 10], radius=32, fill='#114b29', outline='#082614', width=5)\\n    d.rounded_rectangle([16, 16, W - 16, H - 16], radius=28, fill='#145a32', outline='#0d3d22', width=2)\\n\\n    # Header\\n    d.text((28, 26), \\\"CÁCH 1: 6 CỘT LỚN + LÁ ĐÁY GHI SỐ\\\", fill='#fef08a', font=font_title)\\n    d.text((28, 50), \\\"Cột rộng 58px dễ bấm · Thân trên nén 14px làm Pixel · Đáy hiện k/Target\\\", fill='#86efac', font=font_sub)\\n\\n    # Symmetric 6x15 Mushro\n<truncated 9386 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\Admin\\\\.gemini\\\\antigravity\\\\brain\\\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\\\generate_both_demos.py\""}}],"truncated_fields":["tool_calls"]}
