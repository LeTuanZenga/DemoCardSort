  border: 1px solid rgba(255, 255, 255, 0.25);\\n      color: #ffffff\n<truncated 16685 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\Admin\\\\.gemini\\\\antigravity\\\\brain\\\\0ca39d47-bf1d-4d04-97dc-9c2fe64cb8c8\\\\card_sort_cach_1_6cols.html\""}}],"truncated_fields":["tool_calls"]}
